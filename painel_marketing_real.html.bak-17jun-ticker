/* ════════ SINO 🔔 — toca quando entra LEAD novo ou sobe SEGUIDOR (war-room TV)
   Web Audio sintetizado (sem arquivo). Autoplay do browser exige 1 toque/clique
   na tela p/ liberar — aí mostra o aviso "toque para ativar o som". ════════ */
let _ac=null;
function _bellUnlock(){
  try{ if(!_ac) _ac=new (window.AudioContext||window.webkitAudioContext)(); if(_ac.state==="suspended") _ac.resume(); }catch(e){}
  const b=document.getElementById("bell-lock"); if(b && _ac && _ac.state==="running") b.style.display="none";
}
["click","keydown","touchstart","pointerdown"].forEach(ev=>window.addEventListener(ev,_bellUnlock));
function ringBell(times){
  times=Math.min(times||1,3); _bellUnlock();
  if(!_ac || _ac.state!=="running"){ const b=document.getElementById("bell-lock"); if(b) b.style.display="block"; return; }
  const ctx=_ac;
  for(let k=0;k<times;k++){
    const t0=ctx.currentTime+k*0.24;
    [[784,1],[1568,0.5],[3136,0.22]].forEach(([f,a])=>{
      const o=ctx.createOscillator(), g=ctx.createGain();
      o.type="sine"; o.frequency.value=f;
      g.gain.setValueAtTime(0.0001,t0);
      g.gain.exponentialRampToValueAtTime(0.3*a,t0+0.008);
      g.gain.exponentialRampToValueAtTime(0.0001,t0+1.4);
      o.connect(g); g.connect(ctx.destination); o.start(t0); o.stop(t0+1.5);
    });
  }
}
function bellToast(msg){
  const t=document.getElementById("bell-toast"); if(!t) return;
  t.textContent="🔔 "+msg; t.classList.remove("show"); void t.offsetWidth; t.classList.add("show");
  clearTimeout(t._h); t._h=setTimeout(()=>t.classList.remove("show"),5000);
}
function notifyGain(kind,n){
  ringBell(kind==="lead"?2:1);
  if(kind==="lead") bellToast(n>1?(n+" leads novos!"):"Lead novo!");
  else bellToast(n>1?("+"+n+" seguidores!"):"+1 seguidor!");
}
(function(){
  const st=document.createElement("style");
  st.textContent="#bell-toast{position:fixed;top:18px;left:50%;transform:translateX(-50%) translateY(-24px);z-index:99999;background:linear-gradient(135deg,#16331f,#1c4a2b);color:#7CFFA0;padding:12px 28px;border-radius:14px;font:800 22px/1 system-ui,sans-serif;border:1px solid #2f7d4a;box-shadow:0 8px 30px rgba(0,0,0,.55);opacity:0;transition:opacity .35s,transform .35s;pointer-events:none}#bell-toast.show{opacity:1;transform:translateX(-50%) translateY(0)}#bell-lock{display:none;position:fixed;bottom:14px;left:50%;transform:translateX(-50%);z-index:99999;background:#1c2333;color:#cfe;padding:8px 16px;border-radius:20px;font:600 14px/1 system-ui,sans-serif;border:1px solid #2a3550;cursor:pointer}";
  document.head.appendChild(st);
  function mount(){ if(document.getElementById("bell-toast")) return;
    const toast=document.createElement("div"); toast.id="bell-toast"; document.body.appendChild(toast);
    const lock=document.createElement("div"); lock.id="bell-lock"; lock.textContent="🔔 toque na tela para ativar o som"; lock.onclick=_bellUnlock; document.body.appendChild(lock);
  }
  if(document.body) mount(); else document.addEventListener("DOMContentLoaded",mount);
})();

/* ════════ GATILHO REMOTO 🔔 — toca sob comando (escrever bell-trigger.json)
   Permite "mandar um som" pra TV de fora, sem depender de lead/seguidor real. ════════ */
let _lastBellTs=0, _bellTrigInit=false;
async function checkBellTrigger(){
  try{
    const r=await fetch("bell-trigger.json?t="+Date.now(),{cache:"no-store"});
    if(!r.ok) return;
    const d=await r.json();
    const ts=parseInt(d.ts||0);
    if(!_bellTrigInit){ _lastBellTs=ts; _bellTrigInit=true; return; }  /* baseline: nao toca na 1a leitura */
    if(ts>_lastBellTs){
      _lastBellTs=ts;
      if(Date.now()-ts < 120000){                                     /* so toca se for fresco (<2min) */
        ringBell(d.kind==="lead"?2:1);
        bellToast(d.msg || "🔔");
      }
    }
  }catch(e){}
}
setInterval(checkBellTrigger, 8000); checkBellTrigger();

/* ════════ RENDER META ════════ */
function renderMeta(v, postsWeek, meta){
  const monday=mondayOfWeek(new Date()), today=new Date(); today.setHours(0,0,0,0);
  const count=postsWeek.length, pct=Math.min(Math.round(count/meta*100),100);
  // ritmo: compara com o esperado ATÉ AGORA na semana (não pune começo de semana)
  const elapsed=Math.min(7,Math.max(1,Math.floor((today-monday)/864e5)+1));
  const expected=meta*elapsed/7, deficit=expected-count;
  let cls,label;
  if(count>=meta){cls='ok';label='no alvo';}
  else if(deficit<=1){cls='ok';label='no ritmo';}
  else if(deficit<=meta*0.6){cls='mid';label='atrás';}
  else{cls='low';label='crítico';}
  document.getElementById(`${v}-meta`).innerHTML=`${count}<small> / ${meta}</small>`;
  const st=document.getElementById(`${v}-meta-st`);
  st.textContent=label; st.className=`meta-state ${cls}`;
  const fill=document.getElementById(`${v}-meta-fill`); fill.className=`meta-fill ${cls}`; fill.style.width=pct+'%';
  const names=['S','T','Q','Q','S','S','D'], posted=new Array(7).fill(false);
  postsWeek.forEach(p=>{ const d=new Date(p.timestamp); const i=Math.floor((new Date(d.getFullYear(),d.getMonth(),d.getDate())-monday)/864e5); if(i>=0&&i<7) posted[i]=true; });
  let html='';
  for(let i=0;i<7;i++){ const dd=new Date(monday); dd.setDate(dd.getDate()+i);
    let c='meta-day-dot'; if(posted[i])c+=' done'; if(sameDay(dd,today))c+=' today';
    html+=`<div class="meta-day"><div class="${c}"></div><div class="meta-day-lbl">${names[i]}</div></div>`; }
  document.getElementById(`${v}-meta-days`).innerHTML=html;
}

