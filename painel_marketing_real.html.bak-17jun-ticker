      sbFetch('ig_daily_metrics','select=vertical,snapshot_date,followers_total&order=snapshot_date.desc&limit=90'),
      sbFetch('ig_media_metrics','select=vertical,media_id,reach,total_interactions,timestamp,media_product_type,thumbnail_url&reach=gt.0&order=snapshot_date.desc&limit=1000'),
      sbFetch('meta_ads_spend',`select=vertical,spend,leads_count&snapshot_date=gte.${monthStart}`),
      sbFetch('vw_concorrentes_atual','select=username,followers&username=in.(agrolibertas,kobraindtec)').catch(()=>[]),
      sbFetch('vw_concorrentes_atual','select=username,followers,followers_delta,raw,latest_posted_at&vertical=eq.agro').catch(()=>[]),
      sbFetch('meta_ads_spend',`select=spend,reach&snapshot_date=gte.${monthStart}`).catch(()=>[]),
      sbFetch('vw_leads_publico',`select=campanha&created_at=gte.${monthStart}`).catch(()=>[]),
    ]);

    /* 1 concorrente por vertical (dedupe: maior contagem vence o lixo da view) */
    const cMax={};
    for(const r of (conc||[])){ const u=(r.username||'').toLowerCase(), f=r.followers||0;
      if(f>0 && f>(cMax[u]||0)) cMax[u]=f; }
    const setVs=(id,handle,f)=>{ const e=document.getElementById(id);
      if(e) e.innerHTML = f ? `vs <span>@${handle}</span> <b>${fmtFol(f)}</b>` : ''; };
    setVs('agro-vs','agrolibertas',cMax['agrolibertas']);
    setVs('agua-vs','kobraindtec',cMax['kobraindtec']);

    const byVert={}; for(const r of daily)(byVert[r.vertical]||=[]).push(r);
    const mediaMap={}; for(const r of mediaRaw) if(!mediaMap[r.media_id]) mediaMap[r.media_id]=r;
    const allPosts=Object.values(mediaMap);
    allPosts.forEach(p=>{ p.er=p.reach>0?(p.total_interactions/p.reach*100):0; });
    const adsByV={}; for(const r of adsRaw){ const a=(adsByV[r.vertical]||={spend:0,leads:0}); a.spend+=parseFloat(r.spend)||0; a.leads+=parseInt(r.leads_count)||0; }
    /* leads REAIS do CRM por vertical (classifica pela campanha) — substitui o leads_count inflado da Meta.
       AGUA = campanha c/ "AGUA"; AGRO = COMPOSTAGEM/COMPOSTA/ULEXITA; WhatsApp/null ficam fora (nao-atribuiveis). */
    const realLeadsByV={agro:0,agua:0,florestas:0}; let unclAds=0;
    for(const l of (leadsMes||[])){ const c=(l.campanha||'').toUpperCase();
      if(c.includes('AGUA')||c.includes('ÁGUA')) realLeadsByV.agua++;
      else if(c.includes('COMPOSTAGEM')||c.includes('COMPOSTA')||c.includes('ULEXITA')) realLeadsByV.agro++;
      else if(/\[(FORM|LEADS|CAMPANHA)\]/.test(c)) unclAds++; }
    /* guard: lead de form pago que nao casou vertical = campanha nova; avisa pra ajustar a regra (senao CPL daquela vertical superestima) */
    const _uw=document.getElementById('ads-unclassified');
    if(_uw) _uw.textContent = unclAds>0 ? `⚠ ${unclAds} lead(s) de campanha nova sem classificar — ajustar painel` : '';

    const monday=mondayOfWeek(now);
    let gaps=[];

    for(const v of VERTS){
      /* seguidores + delta 7d real */
      const hist=byVert[v]||[];
      const folEl=document.getElementById(`${v}-fol`), dEl=document.getElementById(`${v}-delta`);
      if(hist.length){
        const latest=hist[0]; folEl.textContent=fmtFol(latest.followers_total);
        const tgt=new Date(latest.snapshot_date).getTime()-7*864e5;
        let ref=null,best=Infinity;
        for(const r of hist){ const df=Math.abs(new Date(r.snapshot_date).getTime()-tgt); if(df<best){best=df;ref=r;} }
        if(ref&&ref!==latest){
          const d=latest.followers_total-ref.followers_total, sg=d>0?'+':'';
          dEl.innerHTML=(d>0?'▲':d<0?'▼':'▬')+` ${sg}${fmtNum(d)} <small>esta semana</small>`;
          dEl.className='fol-delta '+(d>0?'up':d<0?'down':'flat');
        } else { dEl.innerHTML='▬ <small>sem histórico 7d</small>'; dEl.className='fol-delta flat'; }
      } else folEl.textContent='—';

      const posts=allPosts.filter(p=>p.vertical===v);
      renderMeta(v, posts.filter(p=>p.timestamp&&new Date(p.timestamp)>=monday), METAS[v]);

      const last=posts.reduce((m,p)=>{ const t=p.timestamp?new Date(p.timestamp).getTime():0; return t>m?t:m; },0);
      const gap=last?Math.floor((Date.now()-last)/864e5):null;
      if(gap!=null&&gap>=4) gaps.push(`${v==='agro'?'Agro':v==='agua'?'Água':'Florestas'} ${gap}d`);

      const com=posts.filter(p=>p.reach>0).sort((a,b)=>new Date(b.timestamp||0)-new Date(a.timestamp||0)).slice(0,30);
      const er=com.length?com.reduce((s,p)=>s+p.er,0)/com.length:null;
      const _adv=adsByV[v]||{spend:0,leads:0};
      renderAds(v, {spend:_adv.spend, leads:realLeadsByV[v]||0}, er);
    }

    /* SINO seguidores: soma followers Araunah; toca se subiu vs ultima visita */
    let _folTot=0; for(const v of VERTS){ const h=byVert[v]; if(h&&h.length) _folTot+=(h[0].followers_total||0); }
    if(_folTot>0){ const pf=parseInt(localStorage.getItem("bell_fol")||"0");
      if(pf>0 && _folTot>pf) notifyGain("fol", _folTot-pf);
      localStorage.setItem("bell_fol", String(_folTot)); }
    /* alert strip — al-leads + funil são atualizados por refreshLeads() (~1min) */
    const gc=document.getElementById('al-gap-cell');
    if(gaps.length){
      document.getElementById('al-gap').textContent=gaps.length;
      document.getElementById('al-gap-detail').textContent=gaps.join(' · ');
      gc.className='alert-cell red'; document.getElementById('al-gap').className='alert-big red';
    } else {
      document.getElementById('al-gap').textContent='0';
      document.getElementById('al-gap-detail').textContent='cadência em dia';
      gc.className='alert-cell green'; document.getElementById('al-gap').className='alert-big green';
    }

    /* painel 2 — Conteúdo & Mercado (snapshot diário) */
    const paid30=(adsReach||[]).reduce((a,r)=>({reach:a.reach+(r.reach||0),spend:a.spend+(parseFloat(r.spend)||0)}),{reach:0,spend:0});
    renderPanel2(allPosts, concAgro, (byVert['agro']||[])[0]?.followers_total, now, paid30);

    /* funil + leads a atender — quase tempo real via refreshLeads() */
    refreshLeads();

  }catch(err){
    console.error('loadData',err);
    /* sem footer: erro aparece como "—" nos números + header fica "sem atualizar há Xmin" */
  }
}
loadData();

/* ════════ ROTAÇÃO DE PAINÉIS — corte seco, ZERO animação (acessibilidade) ════════ */
(function(){
  const seq=[['panel1',40000],['panel2',35000]];
  let i=0;
  (function show(){
    document.getElementById('panel1').classList.toggle('hidden', i!==0);
    document.getElementById('panel2').classList.toggle('hidden', i!==1);
    const dur=seq[i][1];
    i=(i+1)%seq.length;
    setTimeout(show, dur);
  })();
})();
</script>
