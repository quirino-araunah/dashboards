    : '<div class="tp-meta">sem dados</div>';

  /* 3 — Alcance do MES atual (por post, dedupado; ja inclui impulsionamento).
     Δ vs MESMO periodo do mes anterior (mes-ate-hoje vs mes passado-ate-mesmo-dia) = comparacao justa. */
  const _y=now.getFullYear(), _m=now.getMonth(), _dom=now.getDate();
  const curStart=new Date(_y,_m,1).getTime();
  const prevStart=new Date(_y,_m-1,1).getTime();
