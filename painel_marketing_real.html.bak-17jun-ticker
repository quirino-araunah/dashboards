/* ════════ ATUALIZAÇÃO — acessível: troca o valor na hora + fade suave 1×
   (sem rolar dígito, sem escalar — não atrapalha quem tem baixa visão) ════════ */
function bumpEl(el){
  if(!el) return;
  el.classList.remove('bump'); void el.offsetWidth; el.classList.add('bump');
  setTimeout(()=>el.classList.remove('bump'), 600);
}
function animateCount(el, to){
  if(!el) return;
  if(to==null){ el.textContent='—'; return; }
  const cur = parseInt(String(el.textContent).replace(/\D/g,''));
  el.textContent = fmtNum(to);
  if(cur!==to) bumpEl(el);   // mudou → fade suave, sem movimento de dígito
}

/* ════════ LEADS ENTRANDO — volume, quase tempo real (~60s, sem reload) ════════
   Marketing capta; quantos leads entram (hoje/7d/mês). Sem conversão/atend (= Vendas).
   Fonte = banco do CRM (live). IG/Ads continuam no snapshot diário. */
async function refreshLeads(){
  try{
    const now=new Date();
    const ymd=d=>`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
    const monthStart=`${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}-01`;
    const hojeISO=(()=>{const b=new Date(Date.now()-3*3600e3);return b.getUTCFullYear()+'-'+String(b.getUTCMonth()+1).padStart(2,'0')+'-'+String(b.getUTCDate()).padStart(2,'0')+'T03:00:00';})();
    const d7ISO=ymd(new Date(Date.now()-7*864e5));
    const d14ISO=ymd(new Date(Date.now()-14*864e5));
    const [hoje, sem, mes, ano, prev] = await Promise.all([
      sbCount('vw_leads_publico',`created_at=gte.${hojeISO}`),
      sbCount('vw_leads_publico',`created_at=gte.${d7ISO}`),
      sbCount('vw_leads_publico',`created_at=gte.${monthStart}`),
      sbCount('vw_leads_publico','created_at=not.is.null'),  /* Total = todos os leads */
      sbCount('vw_leads_publico',`created_at=gte.${d14ISO}&created_at=lt.${d7ISO}`),
    ]);
    animateCount(document.getElementById('fn-hoje'), hoje);
    animateCount(document.getElementById('fn-sem'),  sem);
    animateCount(document.getElementById('fn-mes'),  mes);
    animateCount(document.getElementById('fn-ano'),  ano);
    /* SINO leads: total de leads; toca se entrou lead novo */
    if(ano!=null){ const pl=parseInt(localStorage.getItem("bell_leads")||"0");
      if(pl>0 && ano>pl) notifyGain("lead", ano-pl);
      localStorage.setItem("bell_leads", String(ano)); }
    /* topo = tendência de captação: últimos 7d vs 7d anteriores (não duplica a faixa) */
    const big=document.getElementById('al-leads');
    const ag=document.getElementById('al-leads-aged');
    const cell=document.getElementById('al-leads-cell');
    if(sem!=null && prev!=null){
      const diff=sem-prev, up=diff>=0;
      const pct = prev>0 ? Math.round(diff/prev*100) : null;
      const arrow = diff>0?'▲':diff<0?'▼':'▬';
      const txt = pct!=null ? `${arrow} ${diff>=0?'+':''}${pct}%`
                             : `${arrow} ${diff>=0?'+':''}${fmtNum(diff)}`;
      if(big.textContent!==txt) bumpEl(big);
      big.textContent = txt;
      if(ag) ag.textContent=`${fmtNum(sem)} vs ${fmtNum(prev)} leads`;
      const tone = diff>0?'green':diff<0?'red':'amber';
      cell.className=`alert-cell ${tone}`; big.className=`alert-big ${tone}`;
    } else {
      big.textContent = sem!=null?fmtNum(sem):'—';
      if(ag) ag.textContent='últimos 7 dias';
    }
    lastLeads = Date.now();   // alimenta o "AO VIVO · atualizado há Xs" do header (fonte única)
  }catch(e){ console.error('refreshLeads',e); }
}
setInterval(refreshLeads, 60*1000);

