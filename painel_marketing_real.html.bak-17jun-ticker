<script>
/* ════════ FIT-TO-SCREEN — canvas nativo 1920×1080 (1:1 na TV Full HD);
   escala só se a fonte tiver outra resolução. ?fit=0.95 = margem anti-corte ════════ */
function fitParam(){
  const m = (location.search.match(/[?&]fit=([0-9.]+)/) || [])[1];
  let f = m ? parseFloat(m) : 1;
  if (!isFinite(f) || f <= 0) f = 1;
  return Math.max(0.5, Math.min(1, f));
}
const FIT = fitParam();
function fitStage(){
  const st = document.getElementById('stagewrap');
  if (!st) return;
  const de = document.documentElement;
  const w = Math.min(window.innerWidth  || 1e9, de.clientWidth  || 1e9);
  const h = Math.min(window.innerHeight || 1e9, de.clientHeight || 1e9);
  st.style.transform = `translate(-50%,-50%) scale(${Math.min(w/1920, h/1080)*FIT})`;
}
window.addEventListener('resize', fitStage);
window.addEventListener('orientationchange', fitStage);
window.addEventListener('load', fitStage);
fitStage();
setTimeout(fitStage, 600);

