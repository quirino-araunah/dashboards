<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PAINEL MARKETING — WAR ROOM</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700;800;900&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --bg:#06090f;--border:#1e2632;
  --text:#ffffff;--muted:#6b7685;--sub:#aab4c4;
  --green:#00e676;--blue:#2da8ff;--orange:#ff8a1f;
  --red:#ff3b3b;--amber:#ffc107;
}
/* glow: número grande "explode" na cor dele (legível de longe na TV) */
/* glow ESTÁTICO (vivo de cor, NÃO se mexe — acessível p/ baixa visão) */
.fol-num,.funil-num,.alert-big,.meta-frac{text-shadow:0 0 .14em currentColor}
/* feedback de "atualizou": fade suave 1×, sem escalar nem rolar dígito */
@keyframes softin{from{opacity:.45}to{opacity:1}}
.bump{animation:softin .5s ease-out}
/* respeita quem pede menos movimento: zera tudo */
@media (prefers-reduced-motion:reduce){
  *{animation:none!important;transition:none!important}
}
html,body{height:100%;width:100%;background:#000;color:var(--text);
  font-family:'Inter',sans-serif;overflow:hidden}
/* canvas fixo 16:9 — escala p/ preencher qualquer tela */
#stagewrap{position:absolute;left:50%;top:50%;
  width:1920px;height:1080px;transform-origin:center center}
.panel{position:absolute;inset:0;background:var(--bg);
  display:flex;flex-direction:column;overflow:hidden}
.panel.hidden{display:none}

/* ── PAINEL 2 — CONTEÚDO & MERCADO ── */
.p2-head{display:flex;justify-content:space-between;align-items:center;
  padding:18px 42px;border-bottom:1.5px solid var(--border);
  background:linear-gradient(180deg,#13181f,#0a0e14);flex-shrink:0}
.p2-title{font-size:30px;font-weight:900;letter-spacing:.8px}
.p2-sub{font-size:15px;color:var(--muted);margin-top:3px}
.p2-date{font-size:22px;font-weight:800;color:var(--sub);text-align:right;text-transform:capitalize}
.p2-body{flex:1;display:flex;flex-direction:column;overflow:hidden}
.p2-lbl{font-size:18px;font-weight:800;text-transform:uppercase;letter-spacing:1.8px;
  color:var(--muted);margin-bottom:14px}
/* ── SHOWCASE: 3 cards grandes (a imagem do post é o herói) ── */
.p2-show{flex:1.05;display:flex;flex-direction:column;padding:22px 40px 16px;min-height:0}
#p2-top{flex:1;display:flex;gap:22px;min-height:0}
.tp{flex:1;display:flex;flex-direction:column;min-width:0;overflow:hidden;
  background:rgba(255,255,255,.025);border:1.5px solid var(--border);border-radius:16px}
.tp-img{flex:1;width:100%;object-fit:contain;background:#11161f;display:flex;
  align-items:center;justify-content:center;font-size:90px;color:var(--muted);min-height:0}
.tp-noimg{font-size:40px;font-weight:900;letter-spacing:4px;
  color:rgba(255,255,255,.55);text-transform:uppercase}
.tp-noimg.agro{background:linear-gradient(135deg,#0d3320,#0a0e14)}
.tp-noimg.agua{background:linear-gradient(135deg,#0b2738,#0a0e14)}
.tp-noimg.florestas{background:linear-gradient(135deg,#332010,#0a0e14)}
.tp-ft{display:flex;align-items:flex-end;justify-content:space-between;gap:14px;
  padding:16px 20px;flex-shrink:0}
.tp-badge{display:inline-block;font-size:14px;font-weight:800;text-transform:uppercase;
  letter-spacing:1px;padding:4px 12px;border-radius:6px;color:#06090f}
.tp-badge.reel{background:var(--amber)}.tp-badge.feed{background:var(--blue)}
.tp-badge.carrossel{background:var(--green)}
.tp-meta{font-size:17px;color:var(--sub);font-weight:700;margin-top:9px}
.tp-meta span{color:var(--muted);font-weight:600}
.tp-er{font-size:60px;font-weight:900;font-variant-numeric:tabular-nums;flex-shrink:0;
  text-align:right;line-height:.9;text-shadow:0 0 .14em currentColor}
.tp-er small{display:block;font-size:13px;color:var(--muted);font-weight:700;
  text-transform:uppercase;letter-spacing:1px;text-shadow:none;margin-top:5px}
/* ── FAIXA DE DADOS ── */
.p2-data{flex:.92;display:grid;grid-template-columns:1fr 1fr;
  border-top:1.5px solid var(--border);overflow:hidden}
.p2-dcol{display:flex;flex-direction:column;justify-content:space-between;
  padding:24px 40px;gap:18px;overflow:hidden}
.p2-dcol.l{border-right:1.5px solid var(--border)}
.ert{display:flex;align-items:center;gap:20px;margin-bottom:18px}
.ert-k{font-size:22px;font-weight:800;width:150px;flex-shrink:0;text-transform:uppercase;letter-spacing:1px}
.ert-bar{flex:1;height:28px;background:rgba(255,255,255,.05);border-radius:7px;overflow:hidden}
.ert-fill{height:100%;border-radius:7px}
.ert-v{font-size:34px;font-weight:900;font-variant-numeric:tabular-nums;width:160px;text-align:right;flex-shrink:0}
.ert-v span{font-size:16px;color:var(--muted);font-weight:700}
.reach-big{font-size:104px;font-weight:900;line-height:1;color:var(--blue);
  font-variant-numeric:tabular-nums;text-shadow:0 0 .14em currentColor}
.reach-sub{font-size:18px;color:var(--muted);font-weight:700;text-transform:uppercase;
  letter-spacing:1.5px;margin-top:10px}
.reach-paid{font-size:21px;color:var(--blue);font-weight:800;margin-top:8px;letter-spacing:.3px}
.header-warn{font-size:17px;color:var(--amber);font-weight:700;margin-top:5px}
.lb{display:flex;align-items:center;gap:18px;padding:11px 8px;border-radius:8px}
.lb-pos{font-size:24px;font-weight:900;color:var(--muted);width:2.4ch;text-align:right;flex-shrink:0;font-variant-numeric:tabular-nums}
.lb-h{font-size:23px;font-weight:800;color:var(--sub);width:15ch;flex-shrink:0;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.lb-bar{flex:1;height:24px;background:rgba(255,255,255,.05);border-radius:7px;overflow:hidden;min-width:0}
.lb-bar i{display:block;height:100%;border-radius:7px;background:var(--sub);opacity:.55}
.lb-f{font-size:28px;font-weight:900;font-variant-numeric:tabular-nums;width:6.5ch;text-align:right;flex-shrink:0}
.lb.us{background:rgba(46,230,118,.12)}
.lb.us .lb-h,.lb.us .lb-f,.lb.us .lb-pos{color:var(--green)}
.lb.us .lb-bar i{background:var(--green);opacity:.95}
.mover{font-size:26px;font-weight:800;color:var(--text);line-height:1.45}
.mover span{color:var(--amber)}
.mover small{display:block;font-size:16px;color:var(--muted);font-weight:600;margin-top:7px}

/* HEADER */
.header{display:flex;justify-content:space-between;align-items:center;
  padding:15px 42px;border-bottom:1.5px solid var(--border);
  background:linear-gradient(180deg,#13181f,#0a0e14);flex-shrink:0}
.header-title{font-size:30px;font-weight:900;letter-spacing:0.75px}
.header-sub{font-size:16.5px;color:var(--muted);margin-top:3px}
.header-right{display:flex;align-items:center;gap:33px}
.clock{font-size:36px;font-weight:800;color:var(--green);font-variant-numeric:tabular-nums;line-height:1}
.date-label{font-size:16.5px;color:var(--muted);margin-top:4.5px;text-transform:capitalize;text-align:right}
.live{display:flex;align-items:center;gap:12px}
.live-dot{width:14px;height:14px;border-radius:50%;background:var(--green);flex-shrink:0;
  box-shadow:0 0 10px var(--green)}
.live-txt{display:flex;flex-direction:column;line-height:1.15;text-align:right}
.live-on{font-size:18px;font-weight:800;color:var(--green);text-transform:uppercase;letter-spacing:1.5px}
.live-age{font-size:15px;font-weight:700;color:var(--sub)}
.live-age.stale{color:var(--red)}

/* ALERT STRIP */
.alert-strip{display:flex;flex-shrink:0;border-bottom:1.5px solid var(--border);background:#0d1117}
.alert-cell{flex:1;display:flex;align-items:center;gap:24px;
  padding:21px 42px;border-right:1.5px solid var(--border)}
.alert-cell:last-child{border-right:none}
.alert-cell.red{border-left:6px solid var(--red)}
.alert-cell.amber{border-left:6px solid var(--amber)}
.alert-cell.green{border-left:6px solid var(--green)}
.alert-big{font-size:69px;font-weight:900;line-height:1;font-variant-numeric:tabular-nums}
.alert-big.red{color:var(--red)}.alert-big.amber{color:var(--amber)}.alert-big.green{color:var(--green)}
.alert-txt{font-size:21px;color:var(--sub);line-height:1.3;font-weight:600}
.alert-txt strong{color:var(--text);font-weight:800}

/* MAIN — 3 colunas */
.main{display:grid;grid-template-columns:1fr 1fr 1fr;flex:1;overflow:hidden}
.col{border-right:1.5px solid var(--border);display:flex;flex-direction:column;
  justify-content:space-between;padding:26px 36px;gap:12px;overflow:hidden}
.col:last-child{border-right:none}
.col-head{display:flex;justify-content:space-between;align-items:flex-start;flex-shrink:0}
.col-vertical{font-size:18px;font-weight:700;text-transform:uppercase;letter-spacing:2px;color:var(--muted)}
.col-handle{font-size:32px;font-weight:900;margin-top:5px}
.col.agro .col-handle{color:var(--green)}
.col.agua .col-handle{color:var(--blue)}
.col.florestas .col-handle{color:var(--orange)}
.col-owner{font-size:17px;color:var(--muted);text-align:right;font-weight:600}
.col-owner b{color:var(--sub);font-weight:800}

.lbl{font-size:18px;font-weight:800;text-transform:uppercase;letter-spacing:1.6px;
  color:var(--muted);margin-bottom:4px}
.divider{height:1.5px;background:var(--border)}

/* seguidores */
.fol-num{font-size:104px;font-weight:900;line-height:.9;letter-spacing:-3px;font-variant-numeric:tabular-nums}
.col.agro .fol-num{color:var(--green)}
.col.agua .fol-num{color:var(--blue)}
.col.florestas .fol-num{color:var(--orange)}
.fol-delta{font-size:30px;font-weight:800;margin-top:8px}
.fol-delta.up{color:var(--green)}.fol-delta.down{color:var(--red)}.fol-delta.flat{color:var(--sub)}
.fol-delta small{font-size:18px;color:var(--muted);font-weight:600}
.fol-vs{font-size:19px;color:var(--sub);font-weight:700;margin-top:8px}
.fol-vs:empty{display:none}
.fol-vs b{color:var(--text);font-variant-numeric:tabular-nums}
.fol-vs span{color:var(--muted);font-weight:600}

/* meta semanal */
.meta-top{display:flex;align-items:baseline;gap:16px}
.meta-frac{font-size:60px;font-weight:900;font-variant-numeric:tabular-nums;line-height:1}
.meta-frac small{font-size:28px;color:var(--muted);font-weight:800}
.meta-state{font-size:21px;font-weight:900;text-transform:uppercase;letter-spacing:1.2px}
.meta-state.ok{color:var(--green)}.meta-state.mid{color:var(--amber)}.meta-state.low{color:var(--red)}
.meta-track{height:16px;background:rgba(255,255,255,.05);border-radius:8px;overflow:hidden;margin:9px 0 8px}
.meta-fill{height:100%;border-radius:8px}
.meta-fill.ok{background:var(--green)}.meta-fill.mid{background:var(--amber)}.meta-fill.low{background:var(--red)}
.meta-days{display:flex;gap:9px}
.meta-day{flex:1;text-align:center}
.meta-day-dot{height:16px;border-radius:5px;background:rgba(255,255,255,.07)}
.meta-day-dot.done{background:var(--green)}
.meta-day-dot.today{outline:3px solid var(--text);outline-offset:2px}
.meta-day-lbl{font-size:14px;color:var(--muted);font-weight:700;margin-top:4px}

/* ads */
.ads-row{display:flex;gap:18px}
.ads-kpi{flex:1;text-align:center}
.ads-val{font-size:40px;font-weight:900;font-variant-numeric:tabular-nums;line-height:1}
.ads-lbl{font-size:16px;color:var(--muted);text-transform:uppercase;letter-spacing:0.8px;
  margin-top:6px;font-weight:700}
.ads-none{font-size:24px;color:var(--muted);font-weight:800;line-height:1.4}
.ads-none b{color:var(--sub)}

/* FUNIL */
.funil{flex-shrink:0;border-top:1.5px solid var(--border);background:#0d1117;
  display:flex;align-items:center;padding:18px 42px;gap:36px;position:relative}
.funil-title{font-size:20px;font-weight:900;text-transform:uppercase;letter-spacing:2.5px;
  color:var(--sub);writing-mode:vertical-rl;transform:rotate(180deg);
  border-left:6px solid var(--amber);padding-left:12px;flex-shrink:0}
.funil-steps{flex:1;display:flex;align-items:center;justify-content:space-around}
.funil-step{text-align:center;flex:1}
.funil-num{font-size:104px;font-weight:900;line-height:1;font-variant-numeric:tabular-nums}
.funil-num.new{color:var(--blue)}.funil-num.todo{color:var(--amber)}.funil-num.won{color:var(--green)}
.funil-lbl{font-size:22px;font-weight:800;text-transform:uppercase;letter-spacing:2px;
  color:var(--sub);margin-top:8px}
.funil-period{font-size:15px;color:var(--muted);margin-top:4px;font-weight:600}
.funil-arrow{font-size:52px;color:var(--muted);font-weight:300;flex-shrink:0}
</style>
</head>
